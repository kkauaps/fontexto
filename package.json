{
  "name": "fontexto",
  "version": "0.1.0",
  "description": "Fontexto: bibliographic citation graph and evidence navigation for academic documents (local-first).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx src/server/cli.ts",
    "demo:seed": "tsx src/server/devtools/seedDemo.ts",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "fetch-model": "node scripts/fetch-model.mjs",
    "build:site": "vite build --mode web && vite build --mode web --ssr prerender.tsx && tsx scripts/build-site-pages.ts",
    "deploy:site": "npm run build:site && node scripts/ensure-kv.mjs && wrangler pages deploy dist/site --project-name=fontexto --commit-dirty=true",
    "fetch-tessdata": "node scripts/fetch-tessdata.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "@xyflow/react": "^12.12.1",
    "d3-force": "^3.0.1",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "elkjs": "^0.12.1",
    "express": "^5.3.0",
    "html-to-image": "^1.11.13",
    "multer": "^2.5.0",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
